{
  "name": "afteroffice",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint -c packages/configuration/oxlint.base.json --ignore-pattern .agents --ignore-pattern .claude --ignore-pattern '**/dist/**' . && biome check --config-path packages/configuration/biome.base.json .",
    "lint:fix": "oxlint -c packages/configuration/oxlint.base.json --ignore-pattern .agents --ignore-pattern .claude --ignore-pattern '**/dist/**' --fix . && biome check --write --config-path packages/configuration/biome.base.json .",
    "format": "biome format --write --config-path packages/configuration/biome.base.json .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build:plugins": "bun run --filter '@afteroffice/plugin-claude' build && bun run --filter '@afteroffice/plugin-opencode' build",
    "prepare": "lefthook install",
    "dev": "bun run --filter './apps/*' dev"
  },
  "devDependencies": {
    "@afteroffice/configuration": "workspace:*",
    "@biomejs/biome": "2.6.5",
    "lefthook": "2.2.2",
    "oxlint": "1.90.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
